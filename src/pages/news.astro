---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import { env } from "cloudflare:workers";
import { getDb } from "../lib/db.js";

export const prerender = false;

let articles = [];

try {
  const sql = getDb(env.DATABASE_URL);
  articles = await sql`
    SELECT id, title, summary, url, source, published_at, created_at
    FROM news_articles
    ORDER BY COALESCE(published_at, created_at) DESC
    LIMIT 200
  `;
} catch (e) {
  articles = [];
}

function dateText(a) {
  const v = a.published_at || a.created_at;
  if (!v) return "";
  return String(v).slice(0, 10).replace(/-/g, ".");
}
---
<Layout
  title="여수동 부동산 소식"
  description="여수동 센트럴타운, 연꽃마을4단지, 산들마을2단지 등 지역 부동산·개발 관련 최신 뉴스를 확인해보세요."
>
  <Container>
    <header class="flex items-center justify-between my-6">
      <a href="/" class="flex items-center gap-2">
        <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-gradient-to-br from-violet-500 to-violet-400 text-white font-bold text-xs shrink-0">센</span>
        <span class="text-lg font-bold text-slate-800">센트럴</span>
      </a>
      <a href="/" class="text-sm text-slate-500 hover:text-violet-500 transition">← 홈으로</a>
    </header>

    <main class="max-w-3xl mx-auto pb-20">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">여수동 부동산 소식</h1>
      <p class="text-slate-500 mb-10">지역 부동산·개발 관련 뉴스 {articles.length}건이에요.</p>

      {articles.length === 0 ? (
        <p class="text-slate-400 text-center py-20">아직 등록된 소식이 없어요.</p>
      ) : (
        <div class="bg-white border border-slate-200 rounded-2xl divide-y divide-slate-100 overflow-hidden">
          {articles.map((a) => (
            <a
              href={a.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start justify-between gap-4 px-5 py-4 hover:bg-slate-50 transition"
            >
              <div class="min-w-0">
                <p class="font-medium text-slate-800">{a.title}</p>
                {a.summary && <p class="text-sm text-slate-500 mt-1">{a.summary}</p>}
              </div>
              <div class="text-right shrink-0">
                {a.source && <p class="text-xs text-slate-400">{a.source}</p>}
                <p class="text-xs text-slate-400">{dateText(a)}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </main>
  </Container>
</Layout>