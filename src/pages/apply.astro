---
import Layout from "../layouts/Layout.astro";
import PropertyConsultForm from "../components/PropertyConsultForm.jsx";

export const prerender = false;
---
<Layout
  title="물건 상담 신청"
  description="전화가 부담스러우시면 여기서 간단히 남겨주세요. 확인 후 빠르게 연락드릴게요."
>
  <div class="min-h-screen bg-slate-50">
    <header class="bg-white border-b border-slate-100 sticky top-0 z-30">
      <div class="max-w-lg mx-auto px-5 py-4 flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-slate-800">센트럴공인중개사</a>
        <a href="/" class="text-xs text-slate-400 hover:text-violet-500 transition">닫기 ✕</a>
      </div>
    </header>

    <main class="max-w-lg mx-auto px-5 pt-6">
      <h1 class="text-2xl font-bold text-slate-900 mb-1">전화 대신, 편하게 남겨주세요</h1>
      <p class="text-slate-500 text-sm mb-8">
        몇 가지만 골라주시면 딱 맞는 매물로 빠르게 연락드릴게요.
      </p>

      <PropertyConsultForm client:load />
    </main>
  </div>
</Layout>